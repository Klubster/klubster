{
  "name": "klubster",
  "version": "0.1.0",
  "private": true,
  "description": "Klubster — le Shopify des associations. Plateforme multi-tenant (Next.js + Supabase).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/db/harnais.sh test",
    "test:db:migrations": "bash scripts/db/harnais.sh migrations",
    "test:db:reconstruction": "bash scripts/db/double-reconstruction.sh",
    "test:db:psql": "bash scripts/db/harnais.sh psql",
    "db:inventaire": "node scripts/db/inventaire.mjs",
    "db:inventaire:verifier": "node scripts/db/inventaire.mjs --verifier"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@types/web-push": "^3.6.4",
    "jsqr": "^1.4.0",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
